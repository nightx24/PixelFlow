{
  "appId": "app.pixelflow.player",
  "productName": "PixelFlow",
  "electronVersion": "34.0.0",
  "copyright": "Copyright © 2026 PixelFlow Contributors",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "build-resources"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "rpm",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "flatpak",
        "arch": ["x64"]
      }
    ],
    "category": "AudioVideo",
    "synopsis": "Minimal, elegant video player and media space",
    "description": "PixelFlow is a modern, high-performance media player featuring gesture controls, folder browsing, audio boost, and subtitle customization.",
    "desktop": {
      "StartupWMClass": "PixelFlow",
      "MimeType": "video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;"
    }
  },
  "deb": {
    "packageCategory": "video",
    "priority": "optional",
    "depends": [
      "libnotify4",
      "libnss3",
      "libxss1",
      "libasound2"
    ]
  },
  "rpm": {
    "packageCategory": "Applications/Multimedia"
  },
  "flatpak": {
    "branch": "stable",
    "runtime": "org.freedesktop.Platform",
    "runtimeVersion": "23.08",
    "sdk": "org.freedesktop.Sdk"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "MP4 Video",
        "description": "MPEG-4 Video File",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Matroska Video",
        "description": "Matroska Video File",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "description": "WebM Video File",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "QuickTime Video",
        "description": "QuickTime Movie",
        "role": "Viewer"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PixelFlow"
  }
}
